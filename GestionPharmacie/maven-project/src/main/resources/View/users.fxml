<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="600.0" prefWidth="1100.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="View.UserController">
    <stylesheets>
        <URL value="@tableview.css" />
    </stylesheets>
   <children>
      <TableView fx:id="userLoginTable" layoutX="125.0" layoutY="145.0" prefHeight="361.0" prefWidth="851.0">
        <columns>
          <TableColumn fx:id="usernameCol" prefWidth="200.0" text="Nom d'utilisateur" />
          <TableColumn fx:id="emailCol" prefWidth="250.0" text="Email" />
          <TableColumn fx:id="dateLoginCol" prefWidth="200.0" text="Date Login" />
          <TableColumn fx:id="dateLogoutCol" prefWidth="200.0" text="Date Logout" />
        </columns>
      </TableView>
      <Button fx:id="btnAccueil" layoutX="915.0" layoutY="556.0" mnemonicParsing="false" onAction="#goAccueil" prefHeight="30.0" prefWidth="150.0" style="-fx-background-color: #2196F3;" text="Accueil" textFill="WHITE" />
   </children>
</AnchorPane>
