<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="704.0" prefWidth="1100.0" styleClass="root" stylesheets="@dashboard.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="View.DashboardController">
   <children>
      <Label layoutX="38.0" layoutY="20.0" text="Dashboard">
         <font>
            <Font size="28.0" />
         </font>
      </Label>
      <Button fx:id="btnRetourAccueil" layoutX="964.0" layoutY="25.0" mnemonicParsing="false" onAction="#goAccueil" prefHeight="30.0" prefWidth="110.0" styleClass="back-btn" text="Accueil" />
      <BarChart fx:id="patientMedicamentsChart" layoutX="38.0" layoutY="78.0" prefHeight="280.0" prefWidth="500.0" title="Patients / Nombre de medicaments">
         <xAxis>
            <CategoryAxis label="Patients" tickLabelFill="WHITE" />
         </xAxis>
         <yAxis>
            <NumberAxis label="Nb medicaments" prefHeight="176.0" prefWidth="65.0" tickLabelFill="WHITE" />
         </yAxis>
      </BarChart>
      <BarChart fx:id="medicamentQteChart" layoutX="562.0" layoutY="78.0" prefHeight="280.0" prefWidth="512.0" title="Medicaments / Quantite">
         <xAxis>
            <CategoryAxis label="Medicaments" tickLabelFill="WHITE" />
         </xAxis>
         <yAxis>
            <NumberAxis label="Quantite" tickLabelFill="WHITE" />
         </yAxis>
      </BarChart>
      <PieChart fx:id="topUsersChart" layoutX="14.0" layoutY="385.0" prefHeight="280.0" prefWidth="488.0" title="Utilisateurs qui se connectent le plus" />
      <BarChart fx:id="expiringMedicamentsChart" layoutX="502.0" layoutY="373.0" prefHeight="280.0" prefWidth="534.0" title="Top 5 medicaments expirant ce mois">
         <xAxis>
            <CategoryAxis label="Medicaments" />
         </xAxis>
         <yAxis>
            <NumberAxis label="Quantite" />
         </yAxis>
      </BarChart>
   </children>
</AnchorPane>
