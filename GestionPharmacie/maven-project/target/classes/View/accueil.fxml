<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="View.AccueilController">
    <stylesheets>
        <URL value="@accueil.css" />
    </stylesheets>
   <children>
      <AnchorPane id="AnchorPane" fx:id="button" layoutY="2.0" prefHeight="559.0" prefWidth="1001.0" styleClass="mainFxmlClass">
         <stylesheets>
            <URL value="@tableview.css" />
         </stylesheets>
         <children>
           <Button fx:id="buttonPat" layoutX="62.0" layoutY="390.0" mnemonicParsing="false" onAction="#handleButtonPat" style="-fx-background-color: green;" text="consulter patient " textFill="WHITE" />
           <Button fx:id="buttonMed" layoutX="307.0" layoutY="390.0" mnemonicParsing="false" onAction="#handleButtonMed" style="-fx-background-color: green;" text="consulter médicament" textFill="WHITE" />
            <Button fx:id="buttonUsers" layoutX="556.0" layoutY="390.0" mnemonicParsing="false" onAction="#handleButtonUsers" style="-fx-background-color: green;" text="gestion des utilisateurs" textFill="WHITE" />
            <Button fx:id="buttonDash" layoutX="840.0" layoutY="390.0" mnemonicParsing="false" onAction="#handleButtonDash" style="-fx-background-color: green;" text="dashboard" textFill="WHITE" />
            <Button fx:id="buttonLogout" layoutX="848.0" layoutY="510.0" mnemonicParsing="false" onAction="#handleButtonLogout" style="-fx-background-color: red;" text="Déconnexion" textFill="WHITE" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
